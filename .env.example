# Local / VPS template. For local free stack see values in .env (gitignored).

DEV_MODE=true

SENTRY_DSN=

POSTGRES_DB_HOST=postgres
POSTGRES_DB_PORT=5432
POSTGRES_DB_USER=
POSTGRES_DB_PASS=
POSTGRES_DB_NAME=

PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

TEST_POSTGRES_DB_HOST=postgres
TEST_POSTGRES_DB_PORT=5432
TEST_POSTGRES_DB_USER=
TEST_POSTGRES_DB_PASS=
TEST_POSTGRES_DB_NAME=

MONGO_DB_HOST=mongodb
MONGO_DB_PORT=27017
MONGO_DB_USER=
MONGO_DB_PASS=
MONGO_DB_NAME=

MONGO_EXPRESS_USER=
MONGO_EXPRESS_PASS=

MYSQL_DB_HOST=mysql
MYSQL_DB_PORT=3306
MYSQL_DB_USER=
MYSQL_DB_PASS=
MYSQL_DB_NAME=
MYSQL_DB_PASS_ROOT=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB_REVOKE_TOKENS=1
REDIS_DB_CACHE=2
REDIS_DB_CELERY_BROKER=3
REDIS_DB_CELERY_RESULT=4
REDIS_DB_CELERY_REDBEAT=5
REDIS_DB_LIMITER=6

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASS=

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=1025
MAIL_SERVER=mailhog
MAIL_FROM_NAME=
MAIL_STARTTLS=false
MAIL_SSL_TLS=false
USE_CREDENTIALS=false
VALIDATE_CERTS=false

API_DOMAIN=http://localhost:8000
FRONTEND_DOMAIN=http://localhost:3000

# Local + Docker. For SePay tunnel tests add: *.trycloudflare.com,*.ngrok-free.app
TRUSTED_HOST=localhost,127.0.0.1,fastapi-container,*.trycloudflare.com,*.ngrok-free.app,*.ngrok.io
TRUSTED_ORIGIN=http://localhost:3000

LOGGING_CLIENT_ERRORS=true
LOGGING_REQUESTS=true

# Container paths when using docker-compose.dev.yml mounts
MEDIA_PATH=/fastapi/media/
LOGS_PATH=/logs/

# Marketplace Sprint1 — signed original URL TTL (seconds)
PIN_ORIGINAL_URL_TTL_SECONDS=300
# Optional override; defaults to JWT_SECRET_KEY
# PIN_MEDIA_SIGNING_SECRET=

# Marketplace Sprint2 — seller eligibility thresholds
MP_ELIGIBILITY_MIN_PINS=5
MP_ELIGIBILITY_MIN_VIEWS=100
MP_ELIGIBILITY_MIN_FOLLOWERS=10
MP_PLATFORM_COMMISSION_PERCENT=0
MP_ORDER_PENDING_TTL_MINUTES=30
MP_USD_TO_VND_RATE=25000
# Local/dev only — never true in production. Mock pay FE + unsigned webhook only when DEV_MODE+this.
MP_SEPAY_MOCK=true
# Live cutover (prod): MP_SEPAY_MOCK=false, DEV_MODE=false, set secret + payment base URL.
# Webhook: POST {API}/api/marketplace/webhooks/sepay · HMAC-SHA256 · payment code prefix DH…
# MP_SEPAY_WEBHOOK_SECRET=
# Optional SePay-hosted pay page (else VietQR from platform STK below):
# MP_SEPAY_PAYMENT_BASE_URL=
# VietinBank API Banking (SePay): transfer memo must start with SEVQR — empty for other banks
# MP_SEPAY_TRANSFER_CONTENT_PREFIX=SEVQR
# Platform receiving STK (buyer pays HERE — Solution 2 lite). VietQR BIN list: https://vietqr.io
# MP_PLATFORM_BANK_BIN=970415
# MP_PLATFORM_BANK_NAME=VietinBank
# MP_PLATFORM_ACCOUNT_NUMBER=
# MP_PLATFORM_ACCOUNT_NAME=
# Seller payout provider: manual | stub | open_api (open_api = NotConfigured until wired)
MP_PAYOUT_PROVIDER=manual
# Optional seed: comma usernames for scripts/seed_marketplace_verified_methods.py
# MP_SEED_VERIFY_USERNAMES=demo_seller
MP_ATTESTATION_VERSION=seller-rights-v1
MP_COPYRIGHT_REPORT_MAX=5
MP_COPYRIGHT_REPORT_WINDOW_SECONDS=3600

YANDEX_STORAGE_KEY=
YANDEX_STORAGE_SECRET_KEY=
YANDEX_STORAGE_BUCKET=

GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=
GOOGLE_OAUTH2_REDIRECT_URI=

# Gemini auto-tag (Celery queue ai_auto_tag + celery-worker-ai)
# AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-flash-lite-latest
AI_AUTO_TAG_ENABLED=false
AI_AUTO_TAG_MAX_TAGS=10

PATH_VIDEO_STREAM=/fastapi/media/stream/

# One-time bootstrap: migration grants admin to this username if the user exists
BOOTSTRAP_ADMIN_USERNAME=

GRAFANA_USER=
GRAFANA_PASSWORD=
